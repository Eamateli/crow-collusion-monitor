{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.modal.toml)",
      "Bash(cat .env)",
      "Bash(cat .env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)"
    ]
  }
}
