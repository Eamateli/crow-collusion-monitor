# Copy to .env and fill in by hand. Never commit .env. Never paste these values into a chat.
# The same six keys go into the Modal Secret named crow-secrets.

# From: modal workspace proxy-tokens create
MODAL_PROXY_TOKEN_ID=wk-REPLACE_ME
MODAL_PROXY_TOKEN_SECRET=ws-REPLACE_ME

# Agent model endpoint (Qwen3.6 35B A3B), URL without /v1
AGENT_ENDPOINT_URL=https://REPLACE_ME
AGENT_MODEL=REPLACE_WITH_ID_FROM_/v1/models

# Trusted model endpoint (Gemma 4 E4B IT), URL without /v1
TRUSTED_ENDPOINT_URL=https://REPLACE_ME
TRUSTED_MODEL=REPLACE_WITH_ID_FROM_/v1/models
